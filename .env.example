"""
.env.example - Example environment configuration

Copy this file to .env and modify values as needed.
"""

# Scanning configuration
CAMERA_INDEX=0
SCAN_TIMEOUT=30
MIN_CONFIDENCE=0.5

# Image processing
IMAGE_QUALITY=95
MAX_IMAGE_SIZE=2048

# Database
DB_PATH=./data/qr_scanner.db
DB_POOL_SIZE=5
DB_TIMEOUT=10

# Features
AUTO_SAVE=true
ENABLE_LOGGING=true
DEBUG_MODE=false

# Directories
DATA_DIR=./data
LOGS_DIR=./logs
