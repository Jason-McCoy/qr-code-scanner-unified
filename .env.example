# .env.example - Example environment configuration
#
# Copy this file to .env and change values as needed.
# Relative paths are taken from the project folder; ~ means your home folder.

# Scanning configuration
CAMERA_INDEX=0
SCAN_TIMEOUT=30
MIN_CONFIDENCE=0.5
# Seconds before the same code is saved again during continuous scanning
DUPLICATE_COOLDOWN=5
# Seconds before a code whose save failed is tried again
SAVE_RETRY_DELAY=1

# Image processing
IMAGE_QUALITY=95
MAX_IMAGE_SIZE=2048

# Database
DB_PATH=./data/qr_scanner.db
DB_POOL_SIZE=5
DB_TIMEOUT=10

# Features
AUTO_SAVE=true
ENABLE_LOGGING=true
DEBUG_MODE=false

# Directories
DATA_DIR=./data
LOGS_DIR=./logs

# Termux: folder that android.scan_latest reads photos from
# CAMERA_DIR=~/storage/dcim/Camera
